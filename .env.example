# Copy this file to .env and edit the copy. Never commit .env.
# Read by docker-compose.yml. See docs/CONFIGURATION.md for every variable.

# Owner token. Leave empty to let the server generate one into the data volume:
#   docker compose exec jarvismind cat /data/.jarvismind_token
JARVISMIND_API_TOKEN=

JARVISMIND_LOG_LEVEL=INFO

# fastembed downloads a model once on first use. Use disabled for keyword search only.
JARVISMIND_EMBEDDING_PROVIDER=fastembed

# Keep direct writes off. Corrections go through modification requests.
JARVISMIND_DIRECT_WRITE_ENABLED=0

# Browser origins allowed to call the API directly. Empty disables CORS.
JARVISMIND_CORS_ORIGINS=
